%% Use case diagram of the DE_CUDA project
flowchart LR
    U(["«actor» Student / experimenter"])
    C(["«actor» Campaign script run_all.py"])
    subgraph S [DE_CUDA system]
        UC1((Run the sequential DE))
        UC2((Run the GPU DE, v1 or v2))
        UC3((Run a variant: CR, current-to-best, jDE))
        UC4((Choose function, D, N and seed))
        UC5((Check the health of the run))
        UC6((Append the result to the common CSV))
        UC7((Run the full campaign))
        UC8((Analyse the results: tables, figures, tests))
        UC9((Compare with the reference paper))
    end
    U --- UC1
    U --- UC2
    U --- UC3
    U --- UC7
    U --- UC8
    C --- UC7
    UC1 -. include .-> UC4
    UC2 -. include .-> UC4
    UC3 -. include .-> UC4
    UC1 -. include .-> UC5
    UC2 -. include .-> UC5
    UC3 -. include .-> UC5
    UC5 -. include .-> UC6
    UC7 -. include .-> UC1
    UC7 -. include .-> UC2
    UC7 -. include .-> UC3
    UC9 -. extend .-> UC8
